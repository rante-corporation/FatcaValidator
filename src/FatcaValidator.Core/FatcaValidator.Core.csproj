<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>FATCA and CRS XML validation engine with the official IRS and OECD XML schemas embedded.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    The official schema packages, embedded under stable names (Schemas/<folder>/<file>) so the
    library, and the native fatca-val binary, need no files next to them. See Schemas/README.md.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Schemas\Fatca\v2.0.1\*.xsd" LogicalName="Schemas/Fatca/v2.0.1/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Crs\v2.0\*.xsd" LogicalName="Schemas/Crs/v2.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Crs\v3.0\*.xsd" LogicalName="Schemas/Crs/v3.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\FatcaNotification\v2.5\*.xsd" LogicalName="Schemas/FatcaNotification/v2.5/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\FatcaMetadata\v1.3\*.xsd" LogicalName="Schemas/FatcaMetadata/v1.3/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Carf\v1.5\*.xsd" LogicalName="Schemas/Carf/v1.5/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Cbc\v2.0\*.xsd" LogicalName="Schemas/Cbc/v2.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\CrsStatusMessage\v2.0\*.xsd" LogicalName="Schemas/CrsStatusMessage/v2.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\CbcStatusMessage\v2.0\*.xsd" LogicalName="Schemas/CbcStatusMessage/v2.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\GenericStatusMessage\v2.0\*.xsd" LogicalName="Schemas/GenericStatusMessage/v2.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Etr\v2.0\*.xsd" LogicalName="Schemas/Etr/v2.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Etr\v3.0\*.xsd" LogicalName="Schemas/Etr/v3.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\EtrStatusMessage\v2.0\*.xsd" LogicalName="Schemas/EtrStatusMessage/v2.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Mdr\v1.0\*.xsd" LogicalName="Schemas/Mdr/v1.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Ntj\v1.0\*.xsd" LogicalName="Schemas/Ntj/v1.0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Stf\v2.2\*.xsd" LogicalName="Schemas/Stf/v2.2/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The built-in rule sets (the FATCA pre-flight's IRS record checks). -->
  <ItemGroup>
    <EmbeddedResource Include="Rules\*.rules.json" LogicalName="Rules/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
